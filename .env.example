PORT=3001
MONGODBURL=mongodb://127.0.0.1:27017/shopsphere
JWT_SECRET=change-me-to-a-long-random-string

# Catalog: product `price` and order `totalPrice` are in INR (Indian Rupees / ₹), not USD.
# Razorpay (https://dashboard.razorpay.com — use Test Mode keys locally)
# Key ID / Secret: "Get test keys" or Settings → API Keys (Key secret verifies Checkout signatures for POST /api/orders/verify-payment)
# Webhook secret: only if you use POST /api/webhooks/razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...  # optional if you only use verify-payment
RAZORPAY_CURRENCY=INR
